#!/bin/bash -e

# Build targets for the "main" workflow.
#
# Each YAML file under .github/build-targets/ groups the build entries for one
# top-level directory. Each entry defines one container image build job. The
# entries are consumed by this script, which filters them down to images whose
# files changed in the PR, then dispatches each entry to the build_container
# job.
#
# Fields:
#   dir              : REQUIRED. build context directory
#   container-image  : REQUIRED. image name (pushed to ghcr.io/cybozu/<name>)
#   scan.enabled     : REQUIRED. true / false
#   scan.team        : REQUIRED if scan.enabled is true. Yamory team name for the image
#   scan.identifier  : Yamory image identifier (e.g., ghcr.io/cybozu/golang:1.25-noble) (default: ghcr.io/cybozu/<container-image>)
#   scan.is_public   : true / false. Whether the image is used in public accessible environment (default: false)
#   platforms        : build platforms (default: linux/amd64)
#   load             : load image into local docker daemon (default: false)
#   target           : Dockerfile target stage
#   make-targets     : make targets run before docker build
#   make-post-targets: make targets run after docker build
#   runner           : runs-on label (default: ubuntu-24.04)
#   go-version       : Go toolchain version (default: build_container job default)
#   disk-cleanup     : perform disk cleanup before build (default: false)

if [ -z "${PR}" ]; then
    echo 'Please supply ${PR}.'
    exit 1
fi

mkdir -p .github/outputs
gh pr view "${PR}" --json files | jq -r '.files[].path' | egrep -v '[.]md$' | xargs -n1 printf "$(pwd)/%s\n" | sort > .github/outputs/__diff.txt

echo "Changed Files:"
cat .github/outputs/__diff.txt | jq -n --raw-input '[inputs]' | yq -P

# Merge per-directory build target files into a single matrix file that
# build_decision can consume.
MATRIX_DIR="${MATRIX_DIR:-.github/build-targets}"
MATRIX_FILE=".github/outputs/__build_targets.yaml"
yq -o=yaml ea '[.[]] | flatten' "${MATRIX_DIR}"/*.yaml > "${MATRIX_FILE}"
JSON_MATRIX="$(yq -ojson '.' "${MATRIX_FILE}")"
OUTPUT_MATRIX='[]'
for i in $(seq $(echo "${JSON_MATRIX}" | jq length)); do
    ENTRY=$(echo "${JSON_MATRIX}" | jq ".[$i - 1]")
    CONTAINER_DIR=$(echo "${ENTRY}" | jq -r '.dir')
    CONTAINER_NAME=$(echo "${ENTRY}" | jq -r '."container-image"')
    echo "Checking ${CONTAINER_NAME}..."
    if grep -F $(realpath "${CONTAINER_DIR}")'/' .github/outputs/__diff.txt > /dev/null; then
        PLAN=$(./build_decision "${MATRIX_FILE}" "${CONTAINER_NAME}" "${CONTAINER_DIR}")
        if [ "$(echo "${PLAN}" | jq -r '.build')" = "true" ]; then
            OUTPUT_MATRIX="$(jq -nc '[inputs] | flatten' <(echo "${OUTPUT_MATRIX}") <(echo "[${PLAN}]"))"
            echo '  build'
        else
            echo '  skip (tag already exists)'
        fi
    else
        echo '  skip (no changes)'
    fi
done

echo "Result:"
echo "${OUTPUT_MATRIX}" | yq -P

# Render matrix
echo "${OUTPUT_MATRIX}" | jq -c > .github/outputs/__matrix.json
