+// criAgeCheckInterval is how often partial lines are checked against max_partial_line_age.
+const criAgeCheckInterval = 10 * time.Second
+
+func (c *criStage) start() {
+	c.wg.Go(func() {
+		ticker := time.NewTicker(criAgeCheckInterval)
+		defer ticker.Stop()
+
+		for {
+			select {
+			case <-c.done:
+				return
+			case <-ticker.C:
+				// Send partial lines which are left unsent for a while.
+				expired := c.partialLinesStriped.FlushOlderThan(time.Now().Add(-c.cfg.MaxPartialLineAge))
+				if len(expired) == 0 {
+					continue
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				if err := c.next(ctx, expired); err != nil {
+					c.logger.Error("failed to flush partial lines due to max age", "err", err)
+				}
+				cancel()
+			}
+		}
+	})
+}
+
 func (c *criStage) stop() {
+	c.once.Do(func() { close(c.done) })
+	c.wg.Wait()
+
 	const flushTimeout = 5 * time.Second
 	ctx, cancel := context.WithTimeout(context.Background(), flushTimeout)
 	defer cancel()
@@ -265,6 +307,25 @@ func (m *partialLinesStriped) FlushIfExceeded() []Entry {
