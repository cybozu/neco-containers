 }
 
+// FlushOlderThan removes and returns partial lines whose timestamp is before threshold.
+func (m *partialLinesStriped) FlushOlderThan(threshold time.Time) []Entry {
+	var entries []Entry
+	for i := range m.stripes {
+		s := &m.stripes[i]
+		s.mu.Lock()
+		for fp, v := range s.data {
+			if v.Timestamp.Before(threshold) {
+				m.logger.Warn("cri stage: flushing partial line due to max age", "labels", v.Labels)
+				entries = append(entries, v)
+				delete(s.data, fp)
+				m.size.Add(-1)
+			}
+		}
+		s.mu.Unlock()
+	}
+	return entries
+}
+
 func (m *partialLinesStriped) stripe(fp model.Fingerprint) *partialLinesStripe {
 	return &m.stripes[fp&(stripeCount-1)]
 }
